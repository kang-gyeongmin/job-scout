# --- LLM 인증 (아래 둘 중 하나) ---
# 매일 자동 실행(launchd/cron)은 로그인 세션 밖이라 키체인 인증을 못 쓴다.
# 구독 그대로 쓰려면: `claude setup-token` 실행 후 출력된 토큰을 여기 넣는다.
CLAUDE_CODE_OAUTH_TOKEN=
# 또는 종량제 API 키 사용 (console.anthropic.com). 비워두면 무시됨.
ANTHROPIC_API_KEY=
# 사람인 오픈 API 키 (https://oapi.saramin.co.kr 에서 발급,
# 설정 후 config.yaml에서 saramin: true)
SARAMIN_API_KEY=
# Notion 연동 (선택) — scripts/setup_notion.py 독스트링 참고
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DB_ID=
# 네이버 메일 계정 (아이디@naver.com 전체)
SMTP_USER=rkdrudals991@naver.com
# 네이버 비밀번호 또는 2단계 인증 시 애플리케이션 비밀번호
SMTP_PASSWORD=
